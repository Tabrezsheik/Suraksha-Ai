PORT=5000
MONGODB_URI=YOUR_MONGODB_ATLAS_CONNECTION_STRING
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
AI_SERVICE_URL=http://localhost:8000
# Routing Provider API Keys (Phase 8 AI Safe Route)
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# PostgreSQL + PostGIS Configuration (Phase 8 Spatial Evidence Engine)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=suraksha_spatial
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# Emergency SMS Gateway Configuration (Provider-Independent Interface)
# Set to 'PROVIDER' for external SMS gateway, or 'ANDROID_SIM' for native device cellular
SURAKSHA_SMS_TRANSPORT=PROVIDER
# Provider identifier (e.g. NONE, CUSTOM, MSG91, GUPSHUP)
SMS_PROVIDER_NAME=NONE

# SMTP Email Configuration (Trusted Contact Emergency Alerts)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here
SMTP_FROM=emergency@suraksha.ai

# External Email Provider Configuration (Account Owner Emergency Alerts)
# Provider identifier (e.g. NONE, CUSTOM, RESEND, SENDGRID)
EMAIL_PROVIDER_NAME=NONE

# SURAKSHA AI Automatic Self-Notification Agent Configuration
# Account owner destination contacts (receives automated self-alerts on SOS activation)
SURAKSHA_ALERT_PHONE=+919876543210
SURAKSHA_ALERT_EMAIL=owner@suraksha.ai

# Feature flag to enable or disable automatic self-notifications (default: true)
SURAKSHA_SELF_NOTIFICATIONS_ENABLED=true

# Gated live test confirmation flag (must be explicitly true to permit live test dispatches)
SURAKSHA_LIVE_TEST_CONFIRM=false

# OpenRouter Language Model Configuration (AI Assistant & Legal Tutor)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
